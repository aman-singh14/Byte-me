// Tang Nano 20K (GW2AR-LV18QN88C8/I7) pin constraints for omni_rear.v
// Header pins 30/31/53/71/72/73 are 3.3 V user I/O (pin 52 is a dual-purpose SSPI pin, so SCK is on 73).
// (30/31/53/71/72 are used the same way in Sipeed's TangNano-20K-example nestang.cst.)
// All grounds must be connected together.

// 27 MHz crystal
IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// SPI from the ESP32-CAM (ESP32 is the master)
IO_LOC  "spi_sck" 73;            // ESP32-CAM GPIO14
IO_PORT "spi_sck" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "spi_mosi" 53;           // ESP32-CAM GPIO13
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "spi_miso" 71;           // ESP32-CAM GPIO2 (high-Z unless CS is low)
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "spi_cs_n" 72;           // ESP32-CAM GPIO15
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// MPU6050 (GY-521 board already has pull-up resistors)
IO_LOC  "i2c_scl" 30;
IO_PORT "i2c_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i2c_sda" 31;
IO_PORT "i2c_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Onboard LEDs (active low): 0 heartbeat, 1 frame, 2 COLLISION, 3 tracking, 4 head turning, 5 IMU ok
IO_LOC  "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
